@@ -0,0 +1,25 @@
+import React from 'react';
+import { render, screen, waitFor } from '@testing-library/react';
+import { afterEach, expect, it, vi } from 'vitest';
+import { CloudInfoProvider, useCloudInfo } from './cloud-info-context';
+import { ExternalInfoProvider, useExternalInfo } from './external-info-context';
+import { axiosInstance } from '../common/axios';
+
+function State() {
+  const cloud = useCloudInfo();
+  const external = useExternalInfo();
+  return <output>{JSON.stringify({ cloud: cloud.cloudInfo, external: external.externalInfo, loading: cloud.isLoading || external.isLoading })}</output>;
+}
+
+afterEach(() => { vi.restoreAllMocks(); vi.unstubAllGlobals(); vi.unstubAllEnvs(); });
+
+it('keeps unavailable cloud data explicit and makes no automatic remote request in private mode', async () => {
+  vi.stubEnv('VITE_OFFLINE', 'true');
+  const request = vi.fn();
+  vi.stubGlobal('fetch', request);
+  const axiosGet = vi.spyOn(axiosInstance, 'get');
+  render(<CloudInfoProvider><ExternalInfoProvider><State /></ExternalInfoProvider></CloudInfoProvider>);
+  await waitFor(() => expect(screen.getByRole('status')).toHaveTextContent('{"cloud":null,"external":null,"loading":false}'));
+  expect(request).not.toHaveBeenCalled();
+  expect(axiosGet).not.toHaveBeenCalled();
+});
