# Modèle des variables de la passerelle. À copier en .env dans ce dossier :
#   cp .env.example .env && chmod 600 .env
# .env n'est JAMAIS commité (gateway/.gitignore et .gitignore racine ;
# vérifier : git check-ignore -v gateway/.env).
#
# TOUTES les valeurs ci-dessous sont volontairement fausses. Aucune ne
# fonctionne, aucune ne doit être recopiée : elles montrent la forme attendue.

# Clé maître LiteLLM (préfixe sk- obligatoire). Générer SANS l'afficher (règle 8) :
#   sed -i "s|^LITELLM_MASTER_KEY=.*|LITELLM_MASTER_KEY=sk-$(openssl rand -hex 32)|" .env
LITELLM_MASTER_KEY=sk-FACTICE-remplacer-par-une-cle-maitre-generee

# Mot de passe du PostgreSQL de LiteLLM (utilisateur et base : litellm, cf. docker-compose.yml)
POSTGRES_PASSWORD=FACTICE-remplacer-mot-de-passe-postgres

# Chaîne de connexion lue par LiteLLM. Le mot de passe DOIT être celui de
# POSTGRES_PASSWORD ; l'hôte est le nom du service compose (postgres), pas localhost.
DATABASE_URL=postgresql://litellm:FACTICE-remplacer-mot-de-passe-postgres@postgres:5432/litellm

# Clé API Anthropic (console.anthropic.com). Sert aux alias smart / balanced / fast.
# Placeholder court à dessein : le hook block-secrets.sh bloque toute écriture
# contenant sk-ant- suivi de 20 caractères ou plus (test-block-secrets.sh le vérifie).
ANTHROPIC_API_KEY=sk-ant-FACTICE-remplacer

# Mot de passe de l'utilisateur admin de Grafana (http://localhost:3000)
GRAFANA_ADMIN_PASSWORD=FACTICE-remplacer-mot-de-passe-grafana

# Export des traces LiteLLM vers Tempo (callbacks: ["otel"] dans config.yaml).
# Ces trois valeurs ne sont PAS des secrets et sont les vraies : tempo est le
# nom du service compose, 4317 son récepteur OTLP gRPC (observability/tempo.yaml),
# litellm-gateway le nom sous lequel les traces apparaissent dans Grafana.
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=litellm-gateway
