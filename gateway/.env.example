# Modèle des variables de la passerelle. À copier en .env dans ce dossier :
#   cp .env.example .env && chmod 600 .env
# .env n'est JAMAIS commité (gateway/.gitignore et .gitignore racine ;
# vérifier : git check-ignore -v gateway/.env).
#
# TOUTES les valeurs ci-dessous sont des consignes entre <…>, pas des exemples :
# aucune ne fonctionne, aucune ne doit être recopiée, aucune ne peut passer
# pour un secret aux yeux d'un détecteur (GitGuardian, hook block-secrets.sh).
# Un placeholder d'apparence aléatoire (ancienne forme FACTICE-…) a valu deux
# fausses alertes « Generic Password » ; ne pas y revenir. L'exclusion de ce
# fichier pour ggshield est déclarée dans .gitguardian.yaml à la racine.

# Clé maître LiteLLM (préfixe sk- obligatoire). Générer SANS l'afficher (règle 8) :
#   sed -i "s|^LITELLM_MASTER_KEY=.*|LITELLM_MASTER_KEY=sk-$(openssl rand -hex 32)|" .env
LITELLM_MASTER_KEY=sk-<openssl rand -hex 32>

# Mot de passe du PostgreSQL de LiteLLM (utilisateur et base : litellm, cf. docker-compose.yml)
POSTGRES_PASSWORD=<openssl rand -hex 16>

# Chaîne de connexion lue par LiteLLM. Le mot de passe DOIT être celui de
# POSTGRES_PASSWORD ; l'hôte est le nom du service compose (postgres), pas localhost.
DATABASE_URL=postgresql://litellm:<same-as-POSTGRES_PASSWORD>@postgres:5432/litellm

# Clé API Anthropic (console.anthropic.com). Sert aux alias smart / balanced / fast.
# Placeholder court à dessein (19 caractères maximum après sk-ant-) : le hook
# block-secrets.sh bloque toute écriture contenant sk-ant- suivi de 20
# caractères ou plus (test-block-secrets.sh le vérifie).
ANTHROPIC_API_KEY=sk-ant-<replace-me>

# Mot de passe de l'utilisateur admin de Grafana (http://localhost:3000)
GRAFANA_ADMIN_PASSWORD=<openssl rand -hex 16>

# Generate QDRANT_API_KEY, QDRANT_READ_ONLY_API_KEY and PROMETHEUS_PASSWORD
# with: uv run --locked ../scripts/securiser_services.py
# The script preserves existing values and creates private container mounts.

# Export des traces LiteLLM vers Tempo (callbacks: ["otel"] dans config.yaml).
# Ces trois valeurs ne sont PAS des secrets et sont les vraies : tempo est le
# nom du service compose, 4317 son récepteur OTLP gRPC (observability/tempo.yaml),
# litellm-gateway le nom sous lequel les traces apparaissent dans Grafana.
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=litellm-gateway

# Optional reviewed recovery/promotion volumes; unset preserves project defaults.
# Changing a name does not copy data. Verify the new volume before starting.
# PLATFORM_PGDATA_VOLUME=
# PLATFORM_TEMPODATA_VOLUME=
# PLATFORM_PROMDATA_VOLUME=
# PLATFORM_GRAFANADATA_VOLUME=
# PLATFORM_QDRANTDATA_VOLUME=
