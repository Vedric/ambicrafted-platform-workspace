    {
      "id": 1,
      "type": "text",
      "title": "SUPERVISED WORK / MEASURED SIGNALS",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Request counters reset on API restart. Stored-run gauges decrease after deletion/retention. Voice durations cover server transcription/synthesis, not microphone capture or perceived round-trip latency."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Retained SRE runs",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ambicrafted_retained_runs{kind=\"graphe\"}) and on() (max(ambicrafted:telemetry_fresh) == 1) and on() (max(ambicrafted_control_api_scrape_success) == 1)",
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No samples",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No samples",
                  "color": "#8b99ad"
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "#3d83b3"
          },
          "decimals": 1,
          "thresholds": {
