    {
      "id": 8,
      "type": "timeseries",
      "title": "API spans · queue & export",
      "description": "Queued includes sent and failed spans; do not sum these outcomes. Sent means accepted by local OTLP, not proven durable or indexed. Application work continues when tracing is unavailable. Dropped or failed exports make the trace view incomplete.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(ambicrafted_trace_spans_total{job=\"platform\"}[$__range]))",
          "legendFormat": "{{outcome}}",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "exemplar": false,
          "datasource": {
