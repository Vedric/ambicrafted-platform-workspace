  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "EXPÉRIENCE / MESURES DU NAVIGATEUR",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**RUM de la première période visible d’un document authentifié.** Au plus une mesure finale LCP, INP et CLS par document, attribuée à sa catégorie de route initiale. Ce n’est ni toute une session SPA ni une mesure des navigations internes. La prise en charge du navigateur et les interactions influent sur la couverture. Aucun texte, URL ou identifiant utilisateur n’est collecté."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "LCP · p75",
      "description": "Estimation par histogramme. Examiner le nombre de mesures avant le percentile ; quelques visites ne qualifient pas les performances d’une population.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.75, sum by (le) (increase(ambicrafted_browser_web_vital_seconds_bucket{job=\"platform\",metric=\"LCP\"}[$__range]))) and on() (max(ambicrafted:telemetry_fresh) == 1) and on() (max(ambicrafted_control_api_scrape_success) == 1)",
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Aucune mesure",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Aucune mesure",
                  "color": "#8b99ad"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds",
            "fixedColor": "#3d83b3"
          },
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2.5
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "wideLayout": true,
        "text": {
          "valueSize": 36,
          "titleSize": 14
        }
      }
    },
