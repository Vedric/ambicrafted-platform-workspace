  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "EXPERIENCE / WHAT THE BROWSER MEASURES",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**RUM from the first visible period of an authenticated document.** At most one final LCP, INP and CLS sample per document, attributed to its initial route category. Not a whole SPA session or a soft-navigation measurement. Browser support and interaction affect coverage. Samples contain no page text, URLs or user identifiers."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "LCP · p75",
      "description": "Bucket-based estimate. Read the sample count before judging the percentile; a few visits do not establish population performance.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.75, sum by (le) (increase(ambicrafted_browser_web_vital_seconds_bucket{job=\"platform\",metric=\"LCP\"}[$__range]))) and on() (max(ambicrafted:telemetry_fresh) == 1) and on() (max(ambicrafted_control_api_scrape_success) == 1)",
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No samples",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No samples",
                  "color": "#8b99ad"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds",
            "fixedColor": "#3d83b3"
          },
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2.5
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "wideLayout": true,
        "text": {
          "valueSize": 36,
          "titleSize": 14
        }
      }
    },
