    {
      "id": 3,
      "type": "timeseries",
      "title": "Débit des spans reçus par service",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(traces_spanmetrics_calls_total[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "exemplar": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "Aucune mesure",
          "mappings": [
            {
              "type": "special",
              "options": {
