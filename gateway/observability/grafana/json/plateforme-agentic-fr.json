      "id": 10,
      "type": "timeseries",
      "title": "Durée serveur · p50",
      "description": "Percentiles estimés par histogramme. Peu d’observations rendent les estimations incertaines. Le streaming est mesuré jusqu’au dernier fragment.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le,group) (rate(ambicrafted_http_request_duration_seconds_bucket{group=~\"assistant|speech_recognition|speech_synthesis\"}[$__rate_interval]))) and on() (max(ambicrafted:telemetry_fresh) == 1) and on() (max(ambicrafted_control_api_scrape_success) == 1)",
