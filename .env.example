# Clé virtuelle restreinte aux alias local et local-embed. Aucune valeur réelle.
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
CONFIDENTIAL_KEY=
# Facultative : évaluations externes de données publiques/synthétiques seulement.
ORCHESTRATOR_KEY=
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=runbooks-current
SRE_ALIAS_RAISONNEMENT=local
SRE_MAX_APPELS_OUTILS=10
SRE_MAX_TOURS=12
SRE_MAX_COUT_USD=0.50
SRE_MAX_DUREE_S=1800
SRE_TIMEOUT_LLM_S=300
SRE_TRACAGE=1
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
# Contrôle local : clé et empreinte du mot de passe créées par ./plateforme.
PLATFORM_PORT=8787
# PLATFORM_STATE_DIR=/chemin/absolu/vers/un/dossier/prive
# Optional dedicated memory volumes for a reviewed recovery/promotion.
# Leave unset to retain the current Compose project volumes.
# PLATFORM_MEMORY_DATA_VOLUME=
# PLATFORM_MEMORY_LOGS_VOLUME=
