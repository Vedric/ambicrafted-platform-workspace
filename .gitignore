# Secrets
.env
.env.*

# Fichiers Claude versionnés (surcharge ~/.gitignore_global), sauf config locale
!CLAUDE.md
!.claude/
.claude/settings.local.json

# Cache local de ggshield (empreintes des derniers matches, pour
# `ggshield secret ignore --last-found`). Local, jamais versionné.
.cache_ggshield

# Dépendances et artefacts
__pycache__/
*.pyc
node_modules/
**/node_modules/
.promptfoo/
evals/output/
*.bak

# Modèle de variables de la passerelle (valeurs factices), à versionner
!.env.example
